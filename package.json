{
  "name": "upaman-app-v5",
  "version": "1.0.0",
  "private": true,
  "description": "Upaman Next.js migration scaffold with preserved v4 look and feel",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "clean": "rm -rf .next out",
    "dev": "NODE_ENV=development next dev",
